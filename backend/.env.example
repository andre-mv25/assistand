# Variables de entorno del backend (Trading Assistant)
# Copia este archivo a .env y rellena los valores reales.

# --- IA (DeepSeek) ---
DEEPSEEK_API_KEY=tu_clave_de_deepseek_aqui

# --- Noticias (opcional pero recomendado para VADER y semaforo) ---
NEWS_API_KEY=tu_clave_de_newsapi_aqui
BANXICO_API_KEY=tu_clave_de_banxico_aqui
GNEWS_API_KEY=tu_clave_de_gnews_aqui

# --- Seguridad (cifrado Fernet) ---
ENCRYPTION_KEY=clave_fernet_generada_aleatoriamente

# --- Base de datos (MongoDB Atlas es el principal) ---
MONGO_URI_LOCAL=mongodb://localhost:27017
MONGO_URI_ATLAS=mongodb+srv://usuario:contraseña@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=trading_assistant

# --- Aplicacion ---
INTERVALO_ACTUALIZACION=60
